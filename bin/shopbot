#!/usr/bin/env bash
# Everyday commands for XDC ShopBot. Run `shopbot help` for the list.
set -euo pipefail
SELF="$(readlink -f "$0")"
APP_DIR="${SHOPBOT_DIR:-$(cd "$(dirname "$SELF")/.." && pwd)}"
NODE="$APP_DIR/runtime/node/bin/node"; [ -x "$NODE" ] || NODE="$(command -v node || true)"
[ -n "$NODE" ] || { echo "Node.js not found. Reinstall with the install command in the README."; exit 1; }
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
SERVICE=xdc-shopbot
REPO="${SHOPBOT_REPO:-s4njk4n/XDC_ShopBot}"
cli() { (cd "$APP_DIR" && "$NODE" --no-warnings src/cli.js "$@"); }
restart() { if command -v systemctl >/dev/null; then $SUDO systemctl restart $SERVICE && echo "Restarted."; fi; }

case "${1:-help}" in
  logs)     exec journalctl -u $SERVICE -f -n 100 --no-hostname -o cat ;;
  start|stop|restart) $SUDO systemctl "$1" $SERVICE; echo "Done: $1." ;;
  status)
    if systemctl is-active --quiet $SERVICE 2>/dev/null; then printf '\033[32m● running\033[0m\n'; else printf '\033[31m● not running\033[0m (see: shopbot logs)\n'; fi
    cli status ;;
  setup)       cli setup && restart ;;
  set-token)   cli set-token && restart ;;
  set-address) cli set-address ;;
  update)
    echo "Fetching the latest installer…"
    curl -fsSL "https://raw.githubusercontent.com/$REPO/main/install.sh" | SHOPBOT_UPDATE=1 SHOPBOT_DIR="$APP_DIR" bash ;;
  uninstall)
    read -r -p "Remove the ShopBot service? Your data in $APP_DIR/data is kept. (y/N) " a
    [[ "$a" =~ ^[Yy] ]] || exit 0
    $SUDO systemctl disable --now $SERVICE 2>/dev/null || true
    $SUDO rm -f /etc/systemd/system/$SERVICE.service /usr/local/bin/shopbot
    $SUDO systemctl daemon-reload 2>/dev/null || true
    echo "Service removed. Delete $APP_DIR yourself once you've kept a backup of $APP_DIR/data." ;;
  help|-h|--help) cli help ;;
  *) cli "$@" ;;
esac
